{
    "compilerOptions": {
      "target": "esnext",
      "module": "commonjs",
      "outDir": "dist",
      "rootDir": "src",
      "strict": true,
      "esModuleInterop": true,
      "forceConsistentCasingInFileNames": true,
      "skipLibCheck": true,
      "resolveJsonModule": true
    },
  "include": ["src/**/*.ts"],
  "exclude": ["src/templates", "src/__tests__", "node_modules", "dist"]
  }
  