# Database
# PostgreSQL example (default)
DATABASE_URL="postgresql://user:password@localhost:5432/{{projectName}}?schema=public"

# MySQL example
# DATABASE_URL="mysql://user:password@localhost:3306/{{projectName}}"

# SQLite example
# DATABASE_URL="file:./dev.db"

# MongoDB example
# DATABASE_URL="mongodb://localhost:27017/{{projectName}}"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# NextAuth.js (if using authentication)
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here"

# OAuth Providers (if using authentication)
# GitHub
GITHUB_ID=""
GITHUB_SECRET=""

# Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email Provider (if using email authentication)
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT=""
EMAIL_FROM=""

# Optional: Analytics
NEXT_PUBLIC_GA_ID=""

# Optional: Sentry
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Optional: Other services
# Add your API keys and secrets here

