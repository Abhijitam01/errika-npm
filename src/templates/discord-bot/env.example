# Discord Bot Configuration
# Copy this file to .env and fill in your values

# Required: Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Required: Your application's client ID (found in OAuth2 section)
CLIENT_ID=your_client_id_here

# Optional: Specific guild ID for faster command registration (good for development)
# Leave empty for global commands (takes up to 1 hour to update)
GUILD_ID=

# Optional: Bot owner's Discord user ID (for owner-only commands)
OWNER_ID=

# Optional: Command prefix for text commands (default: !)
COMMAND_PREFIX=!

# Optional: Environment (development or production)
NODE_ENV=development

# Optional: Database URL (if using Prisma)
# Examples:
# PostgreSQL: postgresql://user:password@localhost:5432/discord_bot
# MySQL: mysql://user:password@localhost:3306/discord_bot
# SQLite: file:./dev.db
DATABASE_URL=

# Optional: Logging level (error, warn, info, debug)
LOG_LEVEL=info

